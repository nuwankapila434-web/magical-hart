<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Magical Particle Heart</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background: #000;
    overflow: hidden;
    font-family: Arial, sans-serif;
}

canvas {
    display: block;
}

.controls {
    position: fixed;
    bottom: 35px;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 18px;
    z-index: 10;
}

button {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 2px solid white;
    cursor: pointer;
    transition: .3s;
}

button:hover {
    transform: scale(1.2);
}

.blue { background: #168cff; }
.red { background: #ff1744; }
.pink { background: #ff4fc8; }
.violet { background: #a855ff; }

.title {
    position: fixed;
    top: 30px;
    width: 100%;
    text-align: center;
    color: white;
    font-size: 18px;
    letter-spacing: 5px;
    opacity: .8;
}

</style>
</head>

<body>

<div class="title">MAGICAL HEART</div>

<canvas id="canvas"></canvas>

<div class="controls">

<button class="blue"
onclick="changeColor('#168cff')"></button>

<button class="red"
onclick="changeColor('#ff1744')"></button>

<button class="pink"
onclick="changeColor('#ff4fc8')"></button>

<button class="violet"
onclick="changeColor('#a855ff')"></button>

</div>

<script>

const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");

let W, H, DPR;

let particles = [];
let floating = [];
let sparks = [];

let color = "#168cff";

const TOTAL = 1000;
const FLOAT_COUNT = 200;

function resize() {

    DPR = Math.min(window.devicePixelRatio || 1, 1.5);

    W = innerWidth;
    H = innerHeight;

    canvas.width = W * DPR;
    canvas.height = H * DPR;

    canvas.style.width = W + "px";
    canvas.style.height = H + "px";

    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

    createHeart();

}

window.addEventListener("resize", resize);

function changeColor(c) {
    color = c;
}

// HEART MATHEMATICS

function heartEquation(t, scale) {

    return {

        x: 16 * Math.pow(Math.sin(t), 3) * scale,

        y: -(13 * Math.cos(t)
        - 5 * Math.cos(2*t)
        - 2 * Math.cos(3*t)
        - Math.cos(4*t)) * scale

    };

}

function insideHeart(x, y) {

    let a = x*x + y*y - 1;

    return a*a*a - x*x*y*y*y <= 0;

}

// CREATE HEART PARTICLES

function createHeart() {

    particles = [];

    const scale = Math.min(W * 0.0105, H * 0.0085);

    for (let i = 0; i < TOTAL; i++) {

        let x, y;

        do {

            x = Math.random() * 2.3 - 1.15;

            y = Math.random() * 2.3 - 1.15;

        } while (!insideHeart(x, y));

        particles.push({

            x: x * scale * 16,

            y: y * scale * 16,

            size: Math.random() * 1.5 + .4,

            phase: Math.random() * Math.PI * 2,

            speed: Math.random() * .7 + .3,

            alpha: Math.random() * .7 + .3

        });

    }

}

// FLOATING PARTICLES

function createFloating() {

    floating = [];

    for (let i = 0; i < FLOAT_COUNT; i++) {

        floating.push({

            x: Math.random() * W,

            y: Math.random() * H,

            speed: Math.random() * 1.2 + .3,

            size: Math.random() * 1.5 + .4,

            phase: Math.random() * 6.28

        });

    }

}

// ENERGY BURST

function spawnBurst() {

    for (let i = 0; i < 3; i++) {

        sparks.push({

            x: W / 2 + (Math.random() - .5) * W * .2,

            y: H * .75,

            vx: (Math.random() - .5) * 2,

            vy: -Math.random() * 3 - 1,

            life: 1,

            size: Math.random() * 2 + .5

        });

    }

}

// GLOWING PLATFORM

function drawPlatform(time) {

    const x = W / 2;

    const y = H * .76;

    ctx.save();

    ctx.globalCompositeOperation = "lighter";

    const glow = ctx.createRadialGradient(
        x, y, 2,
        x, y, W * .22
    );

    glow.addColorStop(0, color);

    glow.addColorStop(.25, color + "88");

    glow.addColorStop(1, "transparent");

    ctx.fillStyle = glow;

    ctx.beginPath();

    ctx.ellipse(
        x, y,
        W * .20,
        H * .055,
        0, 0, Math.PI * 2
    );

    ctx.fill();

    ctx.shadowColor = color;

    ctx.shadowBlur = 30;

    ctx.fillStyle = color;

    ctx.globalAlpha = .7 + Math.sin(time * .003) * .15;

    ctx.beginPath();

    ctx.ellipse(
        x, y,
        W * .135,
        H * .018,
        0, 0, Math.PI * 2
    );

    ctx.fill();

    ctx.restore();

}

// DRAW HEART

function drawHeart(time) {

    const cx = W / 2;

    const cy = H * .40;

    const pulse =
        1 + Math.sin(time * .002) * .025;

    ctx.save();

    ctx.globalCompositeOperation = "lighter";

    for (const p of particles) {

        const movementX =
            Math.sin(time * .001 * p.speed + p.phase);

        const movementY =
            Math.cos(time * .001 * p.speed + p.phase);

        const x = cx + p.x * pulse + movementX * 1.2;

        const y = cy - p.y * pulse + movementY * 1.2;

        const alpha =
            p.alpha * (
                .55 + .45 *
                Math.sin(time * .002 + p.phase) ** 2
            );

        ctx.globalAlpha = alpha;

        ctx.fillStyle = color;

        ctx.shadowColor = color;

        ctx.shadowBlur = 3;

        ctx.beginPath();

        ctx.arc(
            x, y,
            p.size,
            0, Math.PI * 2
        );

        ctx.fill();

    }

    ctx.restore();

}

// FLOATING ENERGY PARTICLES

function drawFloating(time) {

    ctx.save();

    ctx.globalCompositeOperation = "lighter";

    for (const p of floating) {

        p.y -= p.speed;

        p.x += Math.sin(time * .001 + p.phase) * .5;

        if (p.y < H * .35) {

            p.y = H * .76;

            p.x = W / 2 + (Math.random() - .5) * W * .3;

        }

        ctx.globalAlpha = .4 + Math.random() * .5;

        ctx.fillStyle = color;

        ctx.shadowColor = color;

        ctx.shadowBlur = 10;

        ctx.beginPath();

        ctx.arc(
            p.x, p.y,
            p.size,
            0, Math.PI * 2
        );

        ctx.fill();

    }

    ctx.restore();

}

// SPARKS

function drawSparks() {

    ctx.save();

    ctx.globalCompositeOperation = "lighter";

    sparks = sparks.filter(p => p.life > 0);

    for (const p of sparks) {

        p.x += p.vx;

        p.y += p.vy;

        p.life -= .012;

        ctx.globalAlpha = p.life;

        ctx.fillStyle = color;

        ctx.shadowColor = color;

        ctx.shadowBlur = 12;

        ctx.beginPath();

        ctx.arc(
            p.x, p.y,
            p.size,
            0, Math.PI * 2
        );

        ctx.fill();

    }

    ctx.restore();

}

// MAIN ANIMATION

let lastBurst = 0;

function animate(time) {

    ctx.clearRect(0, 0, W, H);

    drawPlatform(time);

    drawHeart(time);

    drawFloating(time);

    if (time - lastBurst > 35) {

        spawnBurst();

        lastBurst = time;

    }

    drawSparks();

    requestAnimationFrame(animate);

}

// START

resize();

createFloating();

requestAnimationFrame(animate);

</script>

</body>
</html>
